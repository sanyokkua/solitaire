{
    "name": "solitaire",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.22.2"
    },
    "scripts": {
        "dev": "vite",
        "dev-network": "vite --host",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -b --pretty false",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit tests/component",
        "test:coverage": "vitest run --coverage",
        "bench": "vitest bench --run",
        "e2e": "playwright test",
        "e2e:headed": "playwright test --headed",
        "prepare": "husky",
        "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,css,html,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@reduxjs/toolkit": "2.12.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-redux": "9.3.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "26.6.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "@vitest/coverage-v8": "5.0.1",
        "@vitest/web-worker": "5.0.1",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "husky": "9.1.7",
        "jsdom": "30.1.1",
        "lint-staged": "17.5.1",
        "prettier": "3.9.8",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    }
}
